PORT=5000
MONGO_URI=mongodb://localhost:27017/smartops
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Google OAuth 2.0 Credentials
# Create these in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gmail SMTP Email Configuration (Nodemailer)
# To send live OTP verification emails to Gmail inboxes:
# 1. Set EMAIL_USER to your Gmail address (e.g., yourname@gmail.com)
# 2. Set EMAIL_PASS to your 16-character Gmail App Password (from https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM="SmartOps Security" <your-sender@gmail.com>
